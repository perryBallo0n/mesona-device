+    private static long getLongExtraCompat(Intent intent, String key1, String key2, long defVal) {
+        if (intent == null) return defVal;
+        Bundle extras = intent.getExtras();
+        if (extras == null) return defVal;
+        Object val = extras.get(key1);
+        if (val == null && key2 != null) {
+            val = extras.get(key2);
+        }
+        if (val instanceof Number) {
+            return ((Number) val).longValue();
+        }
+        if (val instanceof String) {
+            try {
+                return Long.parseLong((String) val);
+            } catch (NumberFormatException ignored) {}
+        }
+        return defVal;
+    }
