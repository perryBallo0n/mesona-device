+    private int[] loadAlbumArtColor(long songId, long albumId, String artist, String track) {
+        ContentResolver cr = mContext.getContentResolver();
+        long resolvedAlbumId = albumId;
+        if (resolvedAlbumId <= 0) {
+            Cursor c = null;
+            try {
+                String[] proj = { MediaStore.Audio.Media.ALBUM_ID };
+                if (songId > 0) {
+                    c = cr.query(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, proj,
+                            MediaStore.Audio.Media._ID + "=?",
+                            new String[] { String.valueOf(songId) }, null);
+                } else if (artist != null && artist.length() > 0 && track != null && track.length() > 0) {
+                    c = cr.query(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, proj,
+                            MediaStore.Audio.Media.ARTIST + "=? AND " + MediaStore.Audio.Media.TITLE + "=?",
+                            new String[] { artist, track }, null);
+                } else if (track != null && track.length() > 0) {
+                    c = cr.query(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, proj,
+                            MediaStore.Audio.Media.TITLE + "=?",
+                            new String[] { track }, null);
+                }
+                if (c != null && c.moveToFirst()) {
+                    resolvedAlbumId = c.getLong(0);
+                }
+            } catch (Exception ignored) {
+            } finally {
+                if (c != null) c.close();
+            }
+        }
+
+        if (resolvedAlbumId <= 0) {
+            return null;
+        }
 
+        Bitmap bmp = decodeScaledFromUri(cr,
+                ContentUris.withAppendedId(Uri.parse("content://media/external/audio/albumart"), resolvedAlbumId));
+        if (bmp == null) {
+            Cursor ac = null;
+            try {
+                ac = cr.query(MediaStore.Audio.Albums.EXTERNAL_CONTENT_URI,
+                        new String[] { MediaStore.Audio.Albums.ALBUM_ART },
+                        MediaStore.Audio.Albums._ID + "=?",
+                        new String[] { String.valueOf(resolvedAlbumId) }, null);
+                if (ac != null && ac.moveToFirst()) {
+                    bmp = decodeScaledFromFile(ac.getString(0));
+                }
+            } catch (Exception ignored) {
+            } finally {
+                if (ac != null) ac.close();
+            }
+        }
+
+        if (bmp == null) {
+            return null;
+        }
+        try {
+            return extractVibrantRgb(bmp);
+        } finally {
+            bmp.recycle();
+        }
+    }
