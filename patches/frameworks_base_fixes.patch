+        mArtPendingKey = artKey;
+        ensureArtHandlerLocked();
+        mArtHandler.post(new Runnable() {
+            public void run() {
+                final int[] rgb = loadAlbumArtColor(songId, albumId, artist, track);
+                synchronized (KeyguardViewMediator.this) {
+                    mArtCacheKey = artKey;
+                    mArtCacheRgb = rgb;
+                    mArtHasResult = true;
+                    if (artKey.equals(mArtPendingKey)) {
+                        mArtPendingKey = null;
+                    }
+                }
+                mHandler.post(new Runnable() {
+                    public void run() {
+                        updateBottomLedBar();
+                    }
+                });
+            }
+        });
+    }
+
+    private void startBottomRgbPulse(int r, int g, int b) {
+        if (mLedFadeRunnable != null) {
+            mHandler.removeCallbacks(mLedFadeRunnable);
+            mLedFadeRunnable = null;
+        }
+        if (mMusicPulsingActive && mPulseLedR == r && mPulseLedG == g && mPulseLedB == b) {
+            return;
+        }
+        StringBuilder sb = new StringBuilder(192);
+        sb.append("3 4 0\n3 5 0\n3 6 0\n");
+        sb.append("1 4 0\n1 5 0\n1 6 0\n");
+        int[] ch = { 4, 5, 6 };
+        int[] vals = { r, g, b };
+        for (int i = 0; i < 3; i++) {
+            if (vals[i] > 0) {
+                int id = ch[i];
+                sb.append("16 ").append(id).append(" 1 1 1\n");
+                sb.append("6 ").append(id).append(" 45\n");
+                sb.append("25 ").append(id).append(' ').append(vals[i]).append('\n');
+            }
+        }
+        for (int i = 0; i < 3; i++) {
+            if (vals[i] > 0) {
+                sb.append("3 ").append(ch[i]).append(" 1\n");
+            }
+        }
+        writeFihLedCmd(sb.toString());
+        mMusicPulsingActive = true;
+        mPulseLedR = r;
+        mPulseLedG = g;
+        mPulseLedB = b;
+        mCurLedR = r;
+        mCurLedG = g;
+        mCurLedB = b;
+        mTargetLedR = r;
+        mTargetLedG = g;
+        mTargetLedB = b;
+    }
+
+    private void animateBottomRgb(final int targetR, final int targetG, final int targetB,
+            final int totalSteps, final int stepMs, final boolean releaseBusyOnFinish) {
+        boolean forceClearPulse = mMusicPulsingActive;
+        mMusicPulsingActive = false;
+
+        if (!forceClearPulse && mLedFadeRunnable != null &&
+                mTargetLedR == targetR && mTargetLedG == targetG && mTargetLedB == targetB) {
+            return;
+        }
+        if (!forceClearPulse && mLedFadeRunnable == null &&
+                mCurLedR == targetR && mCurLedG == targetG && mCurLedB == targetB &&
+                targetR == mTargetLedR && targetG == mTargetLedG && targetB == mTargetLedB) {
+            if (releaseBusyOnFinish) {
+                SystemProperties.set("sys.fih_led.busy", "0");
+            }
+            return;
+        }
+
+        if (mLedFadeRunnable != null) {
+            mHandler.removeCallbacks(mLedFadeRunnable);
+            mLedFadeRunnable = null;
+        }
+
+        final int startR = mCurLedR;
+        final int startG = mCurLedG;
+        final int startB = mCurLedB;
+        mTargetLedR = targetR;
+        mTargetLedG = targetG;
+        mTargetLedB = targetB;
+
+        if (totalSteps <= 1 || (startR == targetR && startG == targetG && startB == targetB)) {
+            mCurLedR = targetR;
+            mCurLedG = targetG;
+            mCurLedB = targetB;
+            writeBottomRgbSteady(targetR, targetG, targetB, true);
+            if (releaseBusyOnFinish) {
+                SystemProperties.set("sys.fih_led.busy", "0");
+            }
+            return;
+        }
+
+        mLedFadeRunnable = new Runnable() {
+            int step = 0;
+            public void run() {
+                synchronized (KeyguardViewMediator.this) {
+                    if (mLedFadeRunnable != this) {
+                        return;
+                    }
+                    step++;
+                    float u = (float) step / (float) totalSteps;
+                    if (u > 1.0f) u = 1.0f;
+                    float ease = u * u * (3.0f - 2.0f * u);
+                    int r = Math.round(startR + (targetR - startR) * ease);
+                    int g = Math.round(startG + (targetG - startG) * ease);
+                    int b = Math.round(startB + (targetB - startB) * ease);
+                    mCurLedR = r;
+                    mCurLedG = g;
+                    mCurLedB = b;
+                    writeBottomRgbSteady(r, g, b, step == 1);
+                    if (step < totalSteps) {
+                        mHandler.postDelayed(this, stepMs);
+                    } else {
+                        mLedFadeRunnable = null;
+                        if (targetR == 0 && targetG == 0 && targetB == 0) {
+                            writeFihLedCmd("1 4 0\n1 5 0\n1 6 0\n");
+                        }
+                        if (releaseBusyOnFinish) {
+                            SystemProperties.set("sys.fih_led.busy", "0");
+                        }
+                    }
+                }
+            }
+        };
+        mHandler.post(mLedFadeRunnable);
+    }
+
+    private boolean isMusicPlayingActive() {
+        if (Boolean.TRUE.equals(mPlaying)) return true;
+        if (Boolean.FALSE.equals(mPlaying) && (SystemClock.uptimeMillis() - mLastMusicFalseMs) < 1000L) {
+            return false;
+        }
+        try {
+            AudioManager am = (AudioManager) mContext.getSystemService(Context.AUDIO_SERVICE);
+            return am != null && am.isMusicActive();
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    private synchronized void updateBottomLedBar() {
+        if (!mBottomLedEnabled) {
+            if (mMusicPulsingActive || mCurLedR != 0 || mCurLedG != 0 || mCurLedB != 0 || mLedFadeRunnable != null) {
+                SystemProperties.set("sys.fih_led.busy", "1");
+                animateBottomRgb(0, 0, 0, mScreenOn ? 10 : 6, 25, true);
+            } else {
+                SystemProperties.set("sys.fih_led.busy", "0");
+            }
+            return;
+        }
+
+        if (mBottomLedMusic && isMusicPlayingActive()) {
+            SystemProperties.set("sys.fih_led.busy", "1");
+            String artKey = mSongId + ":" + mAlbumId + ":"
+                    + (mArtist != null ? mArtist : "") + ":"
+                    + (mTrack != null ? mTrack : "");
+            int[] baseColor = null;
+            if (artKey.equals(mArtCacheKey) && mArtHasResult) {
+                baseColor = mArtCacheRgb;
+            } else {
+                requestAlbumArtColorAsync(artKey, mSongId, mAlbumId, mArtist, mTrack);
+            }
+            if (baseColor == null) {
+                int idx = (int) (Math.abs(mSongId) % MUSIC_PALETTE.length);
+                baseColor = MUSIC_PALETTE[idx];
+            }
+            int r = scaleLed(baseColor[0]);
+            int g = scaleLed(baseColor[1]);
+            int b = scaleLed(baseColor[2]);
+            if (mBottomLedMusicPulse) {
+                startBottomRgbPulse(r, g, b);
+            } else {
+                animateBottomRgb(r, g, b, 12, 25, false);
+            }
+            return;
+        }
+
+        if (mBottomLedLockscreen && mShowing && mScreenOn) {
+            SystemProperties.set("sys.fih_led.busy", "1");
+            int level = (mLastBatteryLevel >= 0) ? mLastBatteryLevel
+                    : (mUpdateMonitor != null ? mUpdateMonitor.getBatteryLevel() : 100);
+            int[] c = getBatteryBarColor(level);
+            animateBottomRgb(scaleLed(c[0]), scaleLed(c[1]), scaleLed(c[2]), 14, 25, false);
+            return;
+        }
+
+        // Keep bottom bar off when unlocked or screen off (and never light it while charging).
+        if (mMusicPulsingActive || mCurLedR != 0 || mCurLedG != 0 || mCurLedB != 0 || mLedFadeRunnable != null) {
+            SystemProperties.set("sys.fih_led.busy", "1");
+            animateBottomRgb(0, 0, 0, mScreenOn ? 12 : 8, 25, true);
+        } else {
+            SystemProperties.set("sys.fih_led.busy", "0");
+        }
+    }
+}
