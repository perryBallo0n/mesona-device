+
+    private static final int[][] MUSIC_PALETTE = {
+        {   0, 110, 160 }, // Cyan
+        {  30,  70, 190 }, // Electric Blue
+        { 130,  20, 160 }, // Violet
+        {  15, 145,  80 }, // Emerald
+        { 170,  75,  10 }, // Warm Amber
+        { 170,  30,  80 }, // Rose
+    };
+
+    private static void writeFihLedCmd(String cmd) {
+        FileWriter fw = null;
+        try {
+            fw = new FileWriter("/sys/class/led/fih_led/control");
+            fw.write(cmd);
+        } catch (IOException e) {
+        } finally {
+            if (fw != null) {
+                try { fw.close(); } catch (IOException ignored) {}
+            }
+        }
+    }
+
+    private static final int[][] BATTERY_LED_ANCHORS = {
+        { 100,   0, 180,  10 }, // Bright green
+        {  75,  15, 115,   0 }, // Dimmer green
+        {  50, 125, 120,   0 }, // Yellow-green / yellow
+        {  25, 180,  60,   0 }, // Warm orange
+        {  10, 190,  10,   0 }, // Red
+    };
+
+    private int mCurLedR = 0;
+    private int mCurLedG = 0;
+    private int mCurLedB = 0;
+    private int mTargetLedR = 0;
+    private int mTargetLedG = 0;
+    private int mTargetLedB = 0;
+    private int mLastBatteryLevel = -1;
+    private Runnable mLedFadeRunnable = null;
+    private long mLastMusicFalseMs = 0L;
+
+    private final KeyguardUpdateMonitor.InfoCallback mBatteryLedCallback =
+            new KeyguardUpdateMonitor.InfoCallback() {
+        public void onRefreshBatteryInfo(boolean showBatteryInfo, boolean pluggedIn, int batteryLevel) {
+            mLastBatteryLevel = batteryLevel;
+            if (mShowing && mScreenOn && !isMusicPlayingActive()) {
+                updateBottomLedBar();
+            }
+        }
+        public void onTimeChanged() {}
+        public void onMusicChanged() {}
+        public void onRefreshCarrierInfo(CharSequence plmn, CharSequence spn) {}
+        public void onRingerModeChanged(int state) {}
+        public void onPhoneStateChanged(String newState) {}
+    };
+
+    private static int[] getBatteryBarColor(int level) {
+        if (level >= BATTERY_LED_ANCHORS[0][0]) {
+            return new int[] {
+                BATTERY_LED_ANCHORS[0][1], BATTERY_LED_ANCHORS[0][2], BATTERY_LED_ANCHORS[0][3]
+            };
+        }
+        int last = BATTERY_LED_ANCHORS.length - 1;
+        if (level <= BATTERY_LED_ANCHORS[last][0]) {
+            return new int[] {
+                BATTERY_LED_ANCHORS[last][1], BATTERY_LED_ANCHORS[last][2], BATTERY_LED_ANCHORS[last][3]
+            };
+        }
+        for (int i = 0; i < last; i++) {
+            int hiLvl = BATTERY_LED_ANCHORS[i][0];
+            int loLvl = BATTERY_LED_ANCHORS[i + 1][0];
+            if (level <= hiLvl && level >= loLvl) {
+                float t = (float) (hiLvl - level) / (float) (hiLvl - loLvl);
+                int r = Math.round(BATTERY_LED_ANCHORS[i][1] + t * (BATTERY_LED_ANCHORS[i + 1][1] - BATTERY_LED_ANCHORS[i][1]));
+                int g = Math.round(BATTERY_LED_ANCHORS[i][2] + t * (BATTERY_LED_ANCHORS[i + 1][2] - BATTERY_LED_ANCHORS[i][2]));
+                int b = Math.round(BATTERY_LED_ANCHORS[i][3] + t * (BATTERY_LED_ANCHORS[i + 1][3] - BATTERY_LED_ANCHORS[i][3]));
+                return new int[] { r, g, b };
+            }
+        }
+        return new int[] { 0, 180, 10 };
+    }
+
+    private static void writeBottomRgbSteady(int r, int g, int b, boolean clearEffects) {
+        StringBuilder sb = new StringBuilder(64);
+        if (clearEffects) {
+            sb.append("3 4 0\n3 5 0\n3 6 0\n");
+        }
+        if (r > 0) {
+            sb.append("4 4 ").append(r).append("\n1 4 1\n");
+        } else {
+            sb.append("1 4 0\n");
+        }
+        if (g > 0) {
+            sb.append("4 5 ").append(g).append("\n1 5 1\n");
+        } else {
+            sb.append("1 5 0\n");
+        }
+        if (b > 0) {
+            sb.append("4 6 ").append(b).append("\n1 6 1\n");
+        } else {
+            sb.append("1 6 0\n");
+        }
+        writeFihLedCmd(sb.toString());
+    }
+
+    private void animateBottomRgb(final int targetR, final int targetG, final int targetB,
+            final int totalSteps, final int stepMs, final boolean releaseBusyOnFinish) {
+        if (mLedFadeRunnable != null &&
+                mTargetLedR == targetR && mTargetLedG == targetG && mTargetLedB == targetB) {
+            return;
+        }
+        if (mLedFadeRunnable == null &&
+                mCurLedR == targetR && mCurLedG == targetG && mCurLedB == targetB &&
+                targetR == mTargetLedR && targetG == mTargetLedG && targetB == mTargetLedB) {
+            if (releaseBusyOnFinish) {
+                SystemProperties.set("sys.fih_led.busy", "0");
+            }
+            return;
+        }
+
+        if (mLedFadeRunnable != null) {
+            mHandler.removeCallbacks(mLedFadeRunnable);
+            mLedFadeRunnable = null;
+        }
+
+        final int startR = mCurLedR;
+        final int startG = mCurLedG;
+        final int startB = mCurLedB;
+        mTargetLedR = targetR;
+        mTargetLedG = targetG;
+        mTargetLedB = targetB;
+
+        if (totalSteps <= 1 || (startR == targetR && startG == targetG && startB == targetB)) {
+            mCurLedR = targetR;
+            mCurLedG = targetG;
+            mCurLedB = targetB;
+            writeBottomRgbSteady(targetR, targetG, targetB, true);
+            if (releaseBusyOnFinish) {
+                SystemProperties.set("sys.fih_led.busy", "0");
+            }
+            return;
+        }
+
+        mLedFadeRunnable = new Runnable() {
+            int step = 0;
+            public void run() {
+                synchronized (KeyguardViewMediator.this) {
+                    if (mLedFadeRunnable != this) {
+                        return;
+                    }
+                    step++;
+                    float u = (float) step / (float) totalSteps;
+                    if (u > 1.0f) u = 1.0f;
+                    float ease = u * u * (3.0f - 2.0f * u);
+                    int r = Math.round(startR + (targetR - startR) * ease);
+                    int g = Math.round(startG + (targetG - startG) * ease);
+                    int b = Math.round(startB + (targetB - startB) * ease);
+                    mCurLedR = r;
+                    mCurLedG = g;
+                    mCurLedB = b;
+                    writeBottomRgbSteady(r, g, b, step == 1);
+                    if (step < totalSteps) {
+                        mHandler.postDelayed(this, stepMs);
+                    } else {
+                        mLedFadeRunnable = null;
+                        if (targetR == 0 && targetG == 0 && targetB == 0) {
+                            writeFihLedCmd("1 4 0\n1 5 0\n1 6 0\n");
+                        }
+                        if (releaseBusyOnFinish) {
+                            SystemProperties.set("sys.fih_led.busy", "0");
+                        }
+                    }
+                }
+            }
+        };
+        mHandler.post(mLedFadeRunnable);
+    }
+
+    private boolean isMusicPlayingActive() {
+        if (Boolean.TRUE.equals(mPlaying)) return true;
+        if (Boolean.FALSE.equals(mPlaying) && (SystemClock.uptimeMillis() - mLastMusicFalseMs) < 1000L) {
+            return false;
+        }
+        try {
+            AudioManager am = (AudioManager) mContext.getSystemService(Context.AUDIO_SERVICE);
+            return am != null && am.isMusicActive();
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    private synchronized void updateBottomLedBar() {
+        if (isMusicPlayingActive()) {
+            SystemProperties.set("sys.fih_led.busy", "1");
+            int idx = (int) (Math.abs(mSongId) % MUSIC_PALETTE.length);
+            int[] c = MUSIC_PALETTE[idx];
+            animateBottomRgb(c[0], c[1], c[2], 12, 25, false);
+            return;
+        }
+
+        if (mShowing && mScreenOn) {
+            SystemProperties.set("sys.fih_led.busy", "1");
+            int level = (mLastBatteryLevel >= 0) ? mLastBatteryLevel
+                    : (mUpdateMonitor != null ? mUpdateMonitor.getBatteryLevel() : 100);
+            int[] c = getBatteryBarColor(level);
+            animateBottomRgb(c[0], c[1], c[2], 14, 25, false);
+            return;
+        }
+
+        // Keep bottom bar off when unlocked or screen off (and never light it while charging).
+        if (mCurLedR != 0 || mCurLedG != 0 || mCurLedB != 0 || mLedFadeRunnable != null) {
+            SystemProperties.set("sys.fih_led.busy", "1");
+            animateBottomRgb(0, 0, 0, mScreenOn ? 12 : 8, 25, true);
+        } else {
+            SystemProperties.set("sys.fih_led.busy", "0");
+        }
+    }
 }
 
 
