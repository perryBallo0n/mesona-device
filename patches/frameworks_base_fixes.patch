+
+    private static final int[][] MUSIC_PALETTE = {
+        {   0, 110, 160 }, // Cyan
+        {  30,  70, 190 }, // Electric Blue
+        { 130,  20, 160 }, // Violet
+        {  15, 145,  80 }, // Emerald
+        { 170,  75,  10 }, // Warm Amber
+        { 170,  30,  80 }, // Rose
+    };
+
+    private static void writeFihLedCmd(String cmd) {
+        FileWriter fw = null;
+        try {
+            fw = new FileWriter("/sys/class/led/fih_led/control");
+            fw.write(cmd);
+        } catch (IOException e) {
+        } finally {
+            if (fw != null) {
+                try { fw.close(); } catch (IOException ignored) {}
+            }
+        }
+    }
+
+    private static void setBottomRgb(int r, int g, int b, boolean breatheBlue) {
+        StringBuilder sb = new StringBuilder();
+        sb.append("3 4 0\n3 5 0\n3 6 0\n");
+        if (r > 0) {
+            sb.append("4 4 ").append(r).append("\n1 4 1\n");
+        } else {
+            sb.append("1 4 0\n");
+        }
+        if (g > 0) {
+            sb.append("4 5 ").append(g).append("\n1 5 1\n");
+        } else {
+            sb.append("1 5 0\n");
+        }
+        if (b > 0) {
+            if (breatheBlue) {
+                sb.append("1 6 0\n25 6 ").append(b).append("\n6 6 3\n3 6 1\n");
+            } else {
+                sb.append("4 6 ").append(b).append("\n1 6 1\n");
+            }
+        } else {
+            sb.append("1 6 0\n");
+        }
+        writeFihLedCmd(sb.toString());
+    }
+
+    private long mLastMusicFalseMs = 0L;
+
+    private boolean isMusicPlayingActive() {
+        if (Boolean.TRUE.equals(mPlaying)) return true;
+        if (Boolean.FALSE.equals(mPlaying) && (SystemClock.uptimeMillis() - mLastMusicFalseMs) < 1000L) {
+            return false;
+        }
+        try {
+            AudioManager am = (AudioManager) mContext.getSystemService(Context.AUDIO_SERVICE);
+            return am != null && am.isMusicActive();
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    private void triggerUnlockLedFlash() {
+        if (isMusicPlayingActive()) {
+            updateBottomLedBar();
+            return;
+        }
+        SystemProperties.set("sys.fih_led.busy", "1");
+        setBottomRgb(0, 90, 150, false);
+        mHandler.postDelayed(new Runnable() {
+            public void run() {
+                updateBottomLedBar();
+            }
+        }, 120);
+    }
+
+    private synchronized void updateBottomLedBar() {
+        boolean musicPlaying = isMusicPlayingActive();
+        if (musicPlaying) {
+            SystemProperties.set("sys.fih_led.busy", "1");
+            int idx = (int) (Math.abs(mSongId) % MUSIC_PALETTE.length);
+            int[] c = MUSIC_PALETTE[idx];
+            setBottomRgb(c[0], c[1], c[2], c[2] >= 100 && c[0] < 80);
+            return;
+        }
+
+        if (mShowing && mScreenOn) {
+            // Soft cyan-blue lockscreen accent
+            SystemProperties.set("sys.fih_led.busy", "1");
+            setBottomRgb(0, 45, 135, true);
+            return;
+        }
+
+        SystemProperties.set("sys.fih_led.busy", "0");
+        if (!mScreenOn && mUpdateMonitor != null && mUpdateMonitor.isDevicePluggedIn()) {
+            // Preserve subtle dim charging accent when screen turns off
+            if (mUpdateMonitor.isDeviceCharged()) {
+                setBottomRgb(0, 35, 0, false);
+            } else {
+                setBottomRgb(40, 14, 0, false);
+            }
+        } else {
+            setBottomRgb(0, 0, 0, false);
+        }
+    }
 }
 
 
