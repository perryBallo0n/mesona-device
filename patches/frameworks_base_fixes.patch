+    private static int[] extractVibrantRgb(Bitmap bmp) {
+        if (bmp == null) return null;
+        int w = bmp.getWidth();
+        int h = bmp.getHeight();
+        if (w <= 0 || h <= 0) return null;
+
+        final int NUM_BINS = 24;
+        float[] binWeight = new float[NUM_BINS];
+        float[] binR = new float[NUM_BINS];
+        float[] binG = new float[NUM_BINS];
+        float[] binB = new float[NUM_BINS];
+        float[] hsv = new float[3];
+
+        double neutralWeight = 0.0;
+        double neutralR = 0.0;
+        double neutralG = 0.0;
+        double neutralB = 0.0;
+
+        int stepX = Math.max(1, w / 48);
+        int stepY = Math.max(1, h / 48);
+        for (int y = 0; y < h; y += stepY) {
+            for (int x = 0; x < w; x += stepX) {
+                int px = bmp.getPixel(x, y);
+                int r = Color.red(px);
+                int g = Color.green(px);
+                int b = Color.blue(px);
+                Color.colorToHSV(px, hsv);
+                float sat = hsv[1];
+                float val = hsv[2];
+                if (val < 0.12f) continue;
+
+                neutralWeight += val;
+                neutralR += r * val;
+                neutralG += g * val;
+                neutralB += b * val;
+
+                if (sat < 0.18f || val < 0.15f) continue;
+
+                int bin = ((int) (hsv[0] / 15.0f)) % NUM_BINS;
+                if (bin < 0) bin += NUM_BINS;
+                float weight = (0.35f + sat * sat) * (0.35f + val);
+                binWeight[bin] += weight;
+                binR[bin] += r * weight;
+                binG[bin] += g * weight;
+                binB[bin] += b * weight;
+            }
+        }
+
+        int bestBin = -1;
+        float bestW = 0f;
+        for (int i = 0; i < NUM_BINS; i++) {
+            if (binWeight[i] > bestW) {
+                bestW = binWeight[i];
+                bestBin = i;
+            }
+        }
+
+        int outR, outG, outB;
+        if (bestBin >= 0 && bestW > 0f) {
+            outR = Math.round(binR[bestBin] / bestW);
+            outG = Math.round(binG[bestBin] / bestW);
+            outB = Math.round(binB[bestBin] / bestW);
+        } else if (neutralWeight > 0.0) {
+            outR = (int) Math.round(neutralR / neutralWeight);
+            outG = (int) Math.round(neutralG / neutralWeight);
+            outB = (int) Math.round(neutralB / neutralWeight);
+            int spread = Math.max(outR, Math.max(outG, outB)) - Math.min(outR, Math.min(outG, outB));
+            if (spread < 18) {
+                return new int[] { 155, 170, 190 };
+            }
+        } else {
+            return null;
+        }
+
+        Color.RGBToHSV(outR, outG, outB, hsv);
+        if (hsv[1] > 0.12f) {
+            hsv[1] = Math.min(1.0f, Math.max(0.55f, hsv[1] * 1.25f));
+        }
+        hsv[2] = 1.0f;
+        int vivid = Color.HSVToColor(hsv);
+        int vr = Color.red(vivid);
+        int vg = Color.green(vivid);
+        int vb = Color.blue(vivid);
+        int maxC = Math.max(vr, Math.max(vg, vb));
+        if (maxC <= 0) return null;
+        final int TARGET_PEAK = 190;
+        return new int[] {
+            (vr * TARGET_PEAK) / maxC,
+            (vg * TARGET_PEAK) / maxC,
+            (vb * TARGET_PEAK) / maxC
+        };
+    }
