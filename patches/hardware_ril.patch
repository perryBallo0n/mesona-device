diff --git a/reference-ril/reference-ril.c b/reference-ril/reference-ril.c
index 633ad8b..25f97f1 100644
--- a/reference-ril/reference-ril.c
+++ b/reference-ril/reference-ril.c
@@ -129,6 +129,7 @@ static int s_repollCallsCount = 0;
 static int s_expectAnswer = 0;
 #endif /* WORKAROUND_ERRONEOUS_ANSWER */
 
+static int s_sim_poll_retries = 0;
 static void pollSIMState (void *param);
 static void setRadioState(RIL_RadioState newState);
 
@@ -495,8 +496,15 @@ static void requestGetCurrentCalls(void *data, size_t datalen, RIL_Token t)
 
     err = at_send_command_multiline ("AT+CLCC", "+CLCC:", &p_response);
 
-    if (err != 0 || p_response->success == 0) {
-        RIL_onRequestComplete(t, RIL_E_GENERIC_FAILURE, NULL, 0);
+    if (err != 0 || p_response == NULL || p_response->success == 0) {
+        at_response_free(p_response);
+        if (sState == RADIO_STATE_OFF || sState == RADIO_STATE_UNAVAILABLE) {
+            RIL_onRequestComplete(t, RIL_E_RADIO_NOT_AVAILABLE, NULL, 0);
+        } else {
+            /* Qualcomm MSM7x27a AT parser returns ERROR to AT+CLCC when SIM is absent/not ready;
+             * returning GENERIC_FAILURE traps GsmCallTracker in a 250ms poll loop holding DATA1 wakelock. */
+            RIL_onRequestComplete(t, RIL_E_SUCCESS, NULL, 0);
+        }
         return;
     }
 
@@ -736,7 +744,7 @@ static void requestRegistrationState(int request, void *data,
 
