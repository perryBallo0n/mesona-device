+
+package com.cyanogenmod.cmparts.activities;
+
+import android.content.ContentResolver;
+import android.os.Bundle;
+import android.os.SystemProperties;
+import android.preference.CheckBoxPreference;
+import android.preference.ListPreference;
+import android.preference.Preference;
+import android.preference.Preference.OnPreferenceChangeListener;
+import android.preference.PreferenceActivity;
+import android.preference.PreferenceScreen;
+import android.provider.Settings;
+
+import com.cyanogenmod.cmparts.R;
+
+public class BottomLedActivity extends PreferenceActivity implements OnPreferenceChangeListener {
+
+    private static final String PREF_ENABLED = "pref_bottom_led_enabled";
+    private static final String PREF_LOCKSCREEN = "pref_bottom_led_lockscreen";
+    private static final String PREF_MUSIC = "pref_bottom_led_music";
+    private static final String PREF_MUSIC_PULSE = "pref_bottom_led_music_pulse";
+    private static final String PREF_NOTIF = "pref_bottom_led_notif";
+    private static final String PREF_CHARGING = "pref_bottom_led_charging";
+    private static final String PREF_BRIGHTNESS = "pref_bottom_led_brightness";
+
+    private CheckBoxPreference mEnabledPref;
+    private CheckBoxPreference mLockscreenPref;
+    private CheckBoxPreference mMusicPref;
+    private CheckBoxPreference mMusicPulsePref;
+    private CheckBoxPreference mNotifPref;
+    private CheckBoxPreference mChargingPref;
+    private ListPreference mBrightnessPref;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        setTitle(R.string.bottom_led_title);
+        addPreferencesFromResource(R.xml.bottom_led_settings);
+
+        PreferenceScreen prefSet = getPreferenceScreen();
+        ContentResolver cr = getContentResolver();
+
+        mEnabledPref = (CheckBoxPreference) prefSet.findPreference(PREF_ENABLED);
+        mLockscreenPref = (CheckBoxPreference) prefSet.findPreference(PREF_LOCKSCREEN);
+        mMusicPref = (CheckBoxPreference) prefSet.findPreference(PREF_MUSIC);
+        mMusicPulsePref = (CheckBoxPreference) prefSet.findPreference(PREF_MUSIC_PULSE);
+        mNotifPref = (CheckBoxPreference) prefSet.findPreference(PREF_NOTIF);
+        mChargingPref = (CheckBoxPreference) prefSet.findPreference(PREF_CHARGING);
+        mBrightnessPref = (ListPreference) prefSet.findPreference(PREF_BRIGHTNESS);
+
+        mEnabledPref.setChecked(Settings.System.getInt(cr, "bottom_led_enabled", 1) != 0);
+        mLockscreenPref.setChecked(Settings.System.getInt(cr, "bottom_led_lockscreen", 1) != 0);
+        mMusicPref.setChecked(Settings.System.getInt(cr, "bottom_led_music", 1) != 0);
+        mMusicPulsePref.setChecked(Settings.System.getInt(cr, "bottom_led_music_pulse", 1) != 0);
+        mNotifPref.setChecked(SystemProperties.getInt("persist.sys.bottom_led_notif", 1) != 0);
+        mChargingPref.setChecked(SystemProperties.getInt("persist.sys.bottom_led_charging", 0) != 0);
+
+        int bright = Settings.System.getInt(cr, "bottom_led_brightness", 100);
+        mBrightnessPref.setValue(String.valueOf(bright));
+        updateBrightnessSummary(String.valueOf(bright));
+        mBrightnessPref.setOnPreferenceChangeListener(this);
+    }
+
+    private void updateBrightnessSummary(String value) {
+        int idx = mBrightnessPref.findIndexOfValue(value);
+        if (idx >= 0) {
+            CharSequence[] entries = mBrightnessPref.getEntries();
+            if (entries != null && idx < entries.length) {
+                mBrightnessPref.setSummary(entries[idx]);
+                return;
+            }
+        }
+        mBrightnessPref.setSummary(R.string.bottom_led_brightness_summary);
+    }
+
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (preference == mBrightnessPref) {
+            String val = String.valueOf(newValue);
+            int intVal = 100;
+            try {
+                intVal = Integer.parseInt(val);
+            } catch (NumberFormatException ignored) {}
+            Settings.System.putInt(getContentResolver(), "bottom_led_brightness", intVal);
+            SystemProperties.set("persist.sys.bottom_led_bright", val);
+            updateBrightnessSummary(val);
+            return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean onPreferenceTreeClick(PreferenceScreen preferenceScreen, Preference preference) {
+        ContentResolver cr = getContentResolver();
+        if (preference == mEnabledPref) {
+            boolean checked = mEnabledPref.isChecked();
+            Settings.System.putInt(cr, "bottom_led_enabled", checked ? 1 : 0);
+            SystemProperties.set("persist.sys.bottom_led_enabled", checked ? "1" : "0");
+            return true;
+        } else if (preference == mLockscreenPref) {
+            Settings.System.putInt(cr, "bottom_led_lockscreen", mLockscreenPref.isChecked() ? 1 : 0);
+            return true;
+        } else if (preference == mMusicPref) {
+            Settings.System.putInt(cr, "bottom_led_music", mMusicPref.isChecked() ? 1 : 0);
+            return true;
+        } else if (preference == mMusicPulsePref) {
+            Settings.System.putInt(cr, "bottom_led_music_pulse", mMusicPulsePref.isChecked() ? 1 : 0);
+            return true;
+        } else if (preference == mNotifPref) {
+            SystemProperties.set("persist.sys.bottom_led_notif", mNotifPref.isChecked() ? "1" : "0");
+            return true;
+        } else if (preference == mChargingPref) {
+            SystemProperties.set("persist.sys.bottom_led_charging", mChargingPref.isChecked() ? "1" : "0");
+            return true;
+        }
+        return super.onPreferenceTreeClick(preferenceScreen, preference);
+    }
+}
