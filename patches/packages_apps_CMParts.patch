+        <CheckBoxPreference
+            android:key="pref_bottom_led_lockscreen"
+            android:title="@string/bottom_led_lockscreen_title"
+            android:summary="@string/bottom_led_lockscreen_summary"
+            android:dependency="pref_bottom_led_enabled"
+            android:defaultValue="true" />
+
+        <CheckBoxPreference
+            android:key="pref_bottom_led_music"
+            android:title="@string/bottom_led_music_title"
+            android:summary="@string/bottom_led_music_summary"
+            android:dependency="pref_bottom_led_enabled"
+            android:defaultValue="true" />
+
+        <CheckBoxPreference
+            android:key="pref_bottom_led_music_pulse"
+            android:title="@string/bottom_led_music_pulse_title"
+            android:summary="@string/bottom_led_music_pulse_summary"
+            android:dependency="pref_bottom_led_music"
+            android:defaultValue="true" />
+
+        <CheckBoxPreference
+            android:key="pref_bottom_led_notif"
+            android:title="@string/bottom_led_notif_title"
+            android:summary="@string/bottom_led_notif_summary"
+            android:dependency="pref_bottom_led_enabled"
+            android:defaultValue="true" />
+
+        <CheckBoxPreference
+            android:key="pref_bottom_led_charging"
+            android:title="@string/bottom_led_charging_title"
+            android:summary="@string/bottom_led_charging_summary"
+            android:dependency="pref_bottom_led_enabled"
+            android:defaultValue="false" />
+
+    </PreferenceCategory>
+
+    <PreferenceCategory android:title="@string/bottom_led_cat_brightness">
+
+        <ListPreference
+            android:key="pref_bottom_led_brightness"
+            android:dialogTitle="@string/bottom_led_brightness_title"
+            android:title="@string/bottom_led_brightness_title"
+            android:summary="@string/bottom_led_brightness_summary"
+            android:dependency="pref_bottom_led_enabled"
+            android:entries="@array/entries_bottom_led_brightness"
+            android:entryValues="@array/values_bottom_led_brightness"
+            android:defaultValue="100" />
+
+    </PreferenceCategory>
+
+</PreferenceScreen>
