diff --git a/adb/services.c b/adb/services.c
index a4edb44..a84a087 100644
--- a/adb/services.c
+++ b/adb/services.c
@@ -191,14 +191,28 @@ void reboot_service(int fd, void *arg)
     pid = fork();
     if (pid == 0) {
         /* ask vdc to unmount it */
-        execl("/system/bin/vdc", "/system/bin/vdc", "volume", "unmount",
-                getenv("EXTERNAL_STORAGE"), "force", NULL);
+        const char *ext = getenv("EXTERNAL_STORAGE");
+        if (ext && *ext) {
+            execl("/system/bin/vdc", "/system/bin/vdc", "volume", "unmount",
+                    ext, "force", NULL);
+        }
+        _exit(127);
     } else if (pid > 0) {
         /* wait until vdc succeeds or fails */
         waitpid(pid, &ret, 0);
     }
-    ret = __reboot(LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2,
-                   LINUX_REBOOT_CMD_RESTART2, (char *)arg);
+    if (arg && strcmp((char *)arg, "recovery") == 0) {
+        adb_mkdir("/cache/recovery", 0770);
+        int fd_boot = adb_creat("/cache/recovery/boot", 0644);
+        if (fd_boot >= 0) adb_close(fd_boot);
+        sync();
+        ret = reboot(RB_AUTOBOOT);
+    } else if (arg && ((char *)arg)[0] != '\0') {
+        ret = __reboot(LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2,
+                       LINUX_REBOOT_CMD_RESTART2, (char *)arg);
+    } else {
+        ret = reboot(RB_AUTOBOOT);
+    }
     if (ret < 0) {
         snprintf(buf, sizeof(buf), "reboot failed: %s\n", strerror(errno));
         writex(fd, buf, strlen(buf));
